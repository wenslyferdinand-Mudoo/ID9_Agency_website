# ID9 backend — Render staging only
# Copy these keys into the Render staging service environment.
# Never commit real credentials or reuse production values.

APP_ENV=staging
MONGO_URL=mongodb+srv://<username>:<password>@<atlas-staging-cluster>/<database>?retryWrites=true&w=majority
DB_NAME=id9_staging_test_<unique_suffix>
JWT_SECRET=REPLACE_WITH_A_NEW_RANDOM_SECRET_AT_LEAST_32_UTF8_BYTES
CORS_ORIGINS=https://<exact-vercel-preview-host>

# Optional: only for creating the first staging administrator.
# Existing administrator passwords are never reset during application startup.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Keep sample content disabled unless a disposable staging dataset is explicitly intended.
SEED_DEMO_CONTENT=false
